# ── Gemini API (OpenAI-compatible) ───────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Số token tối đa cho câu trả lời; tăng nếu muốn bot giải thích dài hơn
GEMINI_MAX_TOKENS=420

# ── Bot Trigger ───────────────────────────────────────────────────────────────
GROUP_PREFIX=@bot 
BOT_MENTION_ALIASES=hamster,commit,bot,ai,hamsito

# ── System Prompt ─────────────────────────────────────────────────────────────
# SYSTEM_PROMPT=Custom prompt for your bot...

# ── Reaction ──────────────────────────────────────────────────────────────────
# Bật/tắt auto reaction
REACTION_ENABLED=true
# Emoji mặc định (fallback khi smart mode tắt hoặc không match)
REACTION_EMOJI=HEART
# Tự động thả emoji vào TẤT CẢ tin nhắn trong group (kể cả không tag bot)
REACTION_ON_GROUP_ALL=false
# Smart emoji: phân tích nội dung tin nhắn để chọn emoji phù hợp
# Angry → 😡, Sad → 😢, Laugh → 😂, Love → ❤️, Surprised → 😮, ...
REACTION_SMART=true
AUTO_STICKER_ENABLED=false
# Số sticker gần nhất cần tránh lặp trong cùng cuộc trò chuyện
STICKER_REPEAT_GUARD=8
# Automatically send a friend request to people who send the bot a DM
AUTO_FRIEND_REQUEST_ENABLED=false
AUTO_FRIEND_REQUEST_MESSAGE=Chào bạn, mình kết bạn nhé!

# Tự research các câu hỏi về tin mới, giá, thời tiết, lịch, review...
RESEARCH_ENABLED=true
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
RESEARCH_MAX_RESULTS=3

# Nhắc việc trong tin nhắn riêng
REMINDER_ENABLED=true
REMINDER_FILE=./data/reminders.json

# UID Zalo của quản trị viên, nhiều UID cách nhau bằng dấu phẩy (bắt buộc để dùng /bot)
ADMIN_UIDS=

# Gửi email qua SMTP (Gmail: dùng App Password, không dùng mật khẩu thường)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com

# Kích thước ảnh tối đa bot được tải về để phân tích (MB)
MAX_IMAGE_MB=10

# ── Runtime ───────────────────────────────────────────────────────────────────
SESSION_FILE=./data/session.json
QR_FILE=./data/qr.png
QR_PORT=3000
HISTORY_DIR=./data/history
# English Coach dùng Gemini để luyện hội thoại; lịch sử và tiến độ tách riêng khỏi chat thường
ENGLISH_COACH_ENABLED=true
ENGLISH_COACH_DIR=./data/english-coach
ENGLISH_DEFAULT_LEVEL=A2
# Không bắt buộc: giờ mặc định để gửi bài từ vựng (người dùng có thể đổi bằng /english daily time)
DAILY_VOCAB_HOUR=7
DAILY_VOCAB_MINUTE=30
# Memory dài hạn chỉ lưu các thông tin người dùng nói rõ muốn bot ghi nhớ
MEMORY_ENABLED=true
MEMORY_DIR=./data/memory
MEMORY_MAX_ITEMS=24
MEMORY_RETRIEVE_COUNT=8
# Bảo vệ bot khỏi spam và giữ chi phí API ổn định
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=3500
MAX_QUESTION_LENGTH=4000
# Dọn cache trong RAM sau thời gian không hoạt động
RUNTIME_CACHE_TTL_MS=1800000
# Cache research theo ngày + câu hỏi trong 15 phút
RESEARCH_CACHE_TTL_MS=900000
# Độ dài tối đa của context digest lịch sử cũ
MAX_CONVERSATION_DIGEST_CHARS=2400
TZ=Asia/Ho_Chi_Minh
