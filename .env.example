# ── MiMo API ──────────────────────────────────────────────────────────────────
# Required: API key của Xiaomi MiMo
MIMO_API_KEY=tp-smcrgjgs8shga1n5m2d1sb1idynwdh6qpdszv7o0llrtpoma
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5

# ── Bot Trigger ───────────────────────────────────────────────────────────────
GROUP_PREFIX=@bot 
BOT_MENTION_ALIASES=hamster,commit,bot,ai

# ── System Prompt ─────────────────────────────────────────────────────────────
# SYSTEM_PROMPT=Custom prompt for your bot...

# ── Reaction ──────────────────────────────────────────────────────────────────
# Bật/tắt auto reaction
REACTION_ENABLED=true
# Emoji mặc định (fallback khi smart mode tắt hoặc không match)
REACTION_EMOJI=HEART
# Tự động thả emoji vào TẤT CẢ tin nhắn trong group (kể cả không tag bot)
REACTION_ON_GROUP_ALL=true
# Smart emoji: phân tích nội dung tin nhắn để chọn emoji phù hợp
# Angry → 😡, Sad → 😢, Laugh → 😂, Love → ❤️, Surprised → 😮, ...
REACTION_SMART=true

# ── Runtime ───────────────────────────────────────────────────────────────────
SESSION_FILE=./data/session.json
QR_FILE=./data/qr.png
QR_PORT=3000
HISTORY_DIR=./data/history
TZ=Asia/Ho_Chi_Minh